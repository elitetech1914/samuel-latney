# Set your public origin before deployment to enable canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Optional HTTPS endpoints that accept a JSON POST. Empty = honest coming-soon UI.
# Configure the destination to deliver contact emails / add newsletter subscribers.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Optional shared Bearer token sent only from the server to the above endpoints.
FORM_WEBHOOK_SECRET=
