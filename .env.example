# Copy this file to .env.local and fill in the values you need.

# Public site origin, e.g. https://example.com. Set before deployment for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://samuellatney.com/

# Zoho Mail SMTP settings. Use the server listed in your Zoho Mail account.
ZOHO_SMTP_HOST=smtp.zoho.com
# 465 uses implicit TLS. 587 uses STARTTLS.
ZOHO_SMTP_PORT=465
# Full Zoho Mail address and SMTP password or app-specific password.
ZOHO_SMTP_USER=contact@samuellatney.com
ZOHO_SMTP_PASSWORD=
# Optional destination. Leave blank to send to ZOHO_SMTP_USER.
FORM_EMAIL_TO=

# Optional HTTPS endpoints that accept JSON POST requests when Zoho SMTP is unconfigured.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Optional shared Bearer token sent only from the server to the above endpoints.
FORM_WEBHOOK_SECRET=
